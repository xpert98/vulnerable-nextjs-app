# Local development values. Docker Compose supplies these automatically.
DATABASE_URL=postgres://beacon:beacon_pass@localhost:5432/beacon

# Public issuer (browser-visible) and internal issuer (server-to-server).
OIDC_ISSUER=http://localhost:8081/realms/beacon
OIDC_INTERNAL_ISSUER=http://localhost:8081/realms/beacon
OIDC_CLIENT_ID=beacon-app
OIDC_CLIENT_SECRET=beacon-app-secret
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# INTENTIONALLY WEAK (testbed). This value is also returned by /api/debug.
SESSION_SECRET=beacon-session-secret-do-not-use

# Where uploads are written / read from.
UPLOAD_DIR=./uploads

APP_URL=http://localhost:3000
